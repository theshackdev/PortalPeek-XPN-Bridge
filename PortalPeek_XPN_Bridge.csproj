<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PortalPeek_XPN_Bridge</AssemblyName>
    <RootNamespace>TheShack.PortalPeekXpnBridge</RootNamespace>
    <Version>1.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ValheimManaged>$(HOME)/.steam/steam/steamapps/common/Valheim/valheim_Data/Managed</ValheimManaged>
    <ProfileRoot>$(HOME)/.config/r2modmanPlus-local/Valheim/profiles/The Shack Pack Test Environment/BepInEx</ProfileRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(ProfileRoot)/core/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(ProfileRoot)/core/0Harmony.dll" Private="false" />
    <Reference Include="assembly_valheim" HintPath="$(ValheimManaged)/assembly_valheim.dll" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(ValheimManaged)/assembly_utils.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ValheimManaged)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ValheimManaged)/UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>

</Project>
